# Wardens Protocol backend configuration.
# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Casper connectivity ---
# Leave WARDENS_MODE=sim to run the full demo loop locally with an in-process
# mirror of WardensCore (deterministic pseudo tx hashes). Set to `chain` once
# WardensCore is deployed and the values below are filled to submit real deploys.
WARDENS_MODE=sim

CASPER_NODE_URL=
CASPER_CHAIN_NAME=casper-test
CASPER_EVENT_STREAM_URL=
CSPR_CLOUD_API_KEY=
WARDENS_CORE_HASH=
BACKEND_PRIVATE_KEY_PATH=
X402_FACILITATOR_URL=

# --- Agent endpoints ---
PARSER_AGENT_URL=http://localhost:4101
FRAUD_AGENT_URL=http://localhost:4102
REGISTRY_AGENT_URL=http://localhost:4103

# --- LLM (agents' explanation text ONLY; never scores/verdicts) ---
# Leave GEMINI_API_KEY empty to run with deterministic templated explanations.
# LLM_PROVIDER: gemini (default) | openai (OpenAI-compatible, e.g. OpenCLAW) | off
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# For LLM_PROVIDER=openai (e.g. OpenCLAW gateway):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=6000

# --- Server ---
PORT=4000
