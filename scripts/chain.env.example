# Wardens Protocol chain environment — template.
# Copy to scripts/chain.env (gitignored) and fill in your values.

export ODRA_CASPER_LIVENET_NODE_ADDRESS="https://node.testnet.casper.network/rpc"
export ODRA_CASPER_LIVENET_CHAIN_NAME="casper-test"

# Use an ABSOLUTE path — the scripts run the executor from contracts/wardens_core,
# so a relative ./keys/... path resolves against the wrong directory.
export ODRA_CASPER_LIVENET_SECRET_KEY_PATH="/absolute/path/to/wardens-protocol/keys/secret_key.pem"

# REQUIRED (the livenet client waits on this SSE stream to confirm each tx).
export ODRA_CASPER_LIVENET_EVENTS_URL="https://node.testnet.casper.network/events"

export CSPR_CLOUD_AUTH_TOKEN=""
export WARDENS_DEPLOY_GAS="600000000000"
export WARDENS_GAS="10000000000"
export WARDENS_CORE_ADDRESS=""
